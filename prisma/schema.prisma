// ==============================================================================
// AROGYANEXUS — Prisma Schema for Local PostgreSQL Database
// Tables: users, doctor_profiles
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  full_name     String
  email         String         @unique
  password_hash String
  phone         String?
  role          String         @default("patient") // Allowed: 'patient' | 'doctor' | 'admin'
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  doctor_profile DoctorProfile?
  appointments   Appointment[]
  profiles       Profile[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model DoctorProfile {
  id                  String   @id @default(uuid())
  user_id             String   @unique
  speciality          String
  registration_number String   @unique
  clinic_name         String
  clinic_address      String
  consultation_fee    Decimal  @db.Decimal(10, 2)
  status              String   @default("pending") // Allowed: 'pending' | 'approved' | 'rejected'
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointments Appointment[]
  photo_url String?
  verified Boolean @default(false)
  clinic_lat Float?
  clinic_lng Float?

  @@index([user_id])
  @@index([status])
  @@index([registration_number])
  @@map("doctor_profiles")
}

model Appointment {
  id                String   @id @default(uuid())
  patient_id        String
  profile_id        String?
  doctor_profile_id String
  appointment_at    DateTime
  reason            String?
  status            String   @default("pending")
  created_at        DateTime @default(now())
  ends_at           DateTime?
  mode              String @default("IN_PERSON")
  cancel_reason     String?
  notes             String?
  seed_key          String? @unique

  patient User @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor  DoctorProfile @relation(fields: [doctor_profile_id], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  visit_record VisitRecord?

  @@index([patient_id, appointment_at])
  @@index([doctor_profile_id, appointment_at])
  @@map("appointments")
}

model Profile {
  id String @id @default(uuid())
  user_id String
  name String
  relation String @default("SELF")
  seed_key String? @unique
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointments Appointment[]
  access ProfileAccess[]
  @@index([user_id])
  @@map("profiles")
}

model ProfileAccess {
  id String @id @default(uuid())
  profile_id String
  user_id String
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  @@unique([profile_id, user_id])
  @@map("profile_access")
}

model VisitRecord {
  id String @id @default(uuid())
  appointment_id String @unique
  prescription_file_key String?
  report_file_key String?
  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  @@map("visit_records")
}
